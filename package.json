{
  "name": "relay-monorepo",
  "private": true,
  "workspaces": [
    "apps/desktop/frontend",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "frontend:dev": "npm --workspace @relay/desktop-frontend run dev",
    "frontend:build": "npm --workspace @relay/desktop-frontend run build",
    "frontend:check": "npm --workspace @relay/desktop-frontend run check",
    "frontend:e2e": "npm --workspace @relay/desktop-frontend run e2e",
    "frontend:e2e:headed": "npm --workspace @relay/desktop-frontend run e2e:headed",
    "frontend:e2e:headed:slow": "npm --workspace @relay/desktop-frontend run e2e:headed:slow",
    "perf:fixtures": "node scripts/generate-perf-fixtures.mjs",
    "backend:test": "make -C apps/desktop test",
    "desktop:dev": "make -C apps/desktop dev",
    "desktop:build": "make -C apps/desktop build",
    "web:dev": "npm --workspace @relay/web run dev",
    "web:build": "npm --workspace @relay/web run build",
    "web:check-docs": "node scripts/check-web-docs.mjs",
    "web:preview": "npm --workspace @relay/web run preview"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "svelte-eslint-parser": "^1.8.0",
    "typescript-eslint": "^8.65.0"
  }
}
