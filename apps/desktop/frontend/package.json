{
  "name": "@relay/desktop-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed --project=chromium",
    "e2e:headed:slow": "RELAY_E2E_SLOWMO_MS=450 RELAY_E2E_STEP_PAUSE_MS=900 playwright test --headed --project=chromium",
    "e2e:debug": "playwright test --debug --project=chromium"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lint": "^6.9.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "codemirror": "^6.0.2",
    "svelte": "^5.56.7",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "svelte-check": "^4.7.3",
    "typescript": "^7.0.2",
    "vitest": "^2.0.0"
  }
}
