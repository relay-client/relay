---
const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<h1 id="_top">{title}</h1>
{description && <p class="relay-page-lead">{description}</p>}

<style>
  h1 {
    margin-top: 0.75rem;
    font-size: var(--sl-text-h1);
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -0.028em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .relay-page-lead {
    margin-top: 0.75rem;
    max-width: 42rem;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
</style>
