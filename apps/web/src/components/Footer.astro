---
import Default from '@astrojs/starlight/components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Default><slot /></Default>

<div class="relay-site-footer">
  <span>© 2026 Relay Client · MIT licensed</span>
  <nav aria-label="Footer">
    <a href={base}>Home</a>
    <a href={`${base}download/`}>Download</a>
    <a href={`${base}changelog/`}>Changelog</a>
    <a href={`${base}privacy/`}>Privacy</a>
    <a href="https://github.com/relay-client/relay/issues">Report an issue</a>
  </nav>
</div>

<style>
  .relay-site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--relay-hairline);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .relay-site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .relay-site-footer a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .relay-site-footer a:hover {
    color: var(--sl-color-white);
  }
</style>
